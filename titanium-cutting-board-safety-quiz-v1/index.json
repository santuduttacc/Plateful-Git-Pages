if\"><source srcset=\"https://assets.prd.heyflow.com/flows/Fh8Gt0iSrNlqDz2cXdZ5/www/assets/a8a01f11-5fc3-4121-825b-63566dfb6951/large-icon.webp 400w\" type=\"image/webp\"><img loading=\"eager\" src=\"https://assets.prd.heyflow.com/flows/Fh8Gt0iSrNlqDz2cXdZ5/www/assets/a8a01f11-5fc3-4121-825b-63566dfb6951/original.png\" alt=\"Other\" class=\" \"></picture></div><div class=\"label-container\"><div class=\"label\"><span>Other</span></div></div></div><div></div></label></div></div></div></fieldset></div></div>\n\t\t\t\t\t\t    \n\t\t\t\t\t\t</div></div></section>\t\t\t<section id=\"id-84250dde\" name=\"6-plastic\" data-type=\"user\" data-header=\"header\">\n\t\t\t\t\t<div class=\"block  \" style=\" \" data-blocktype=\"rich-text\" data-blockid=\"id-d1ba41b9\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"block-content text-block align-center inner-wide\" id=\"text-block-id-d1ba41b9\">\n\t\t\t\t\t\t  \n\t\t\t\t\t\t      <div data-block-id=\"id-d1ba41b9\" data-config=\"{&quot;blockName&quot;:&quot;richText&quot;,&quot;blockId&quot;:&quot;id-d1ba41b9&quot;,&quot;blockType&quot;:&quot;rich-text&quot;,&quot;legacySpacingStyle&quot;:&quot;padding-top:10px; padding-bottom:0px; &quot;,&quot;content&quot;:&quot;&lt;h2&gt;Plastic Boards Shed Microplastics Into Food&lt;/h2&gt;&quot;,&quot;outerClassName&quot;:&quot;align-center inner-wide&quot;}\" data-hydration-root=\"true\"><div class=\"rich-text\" style=\"padding-top:10px;padding-bottom:0px\"><h2>Plastic Boards Shed Microplastics Into Food</h2></div></div>\n\t\t\t\t\t\t    \n\t\t\t\t\t\t</div></div>\t\t<div class=\"block  \" style=\" \" data-blocktype=\"rich-text\" data-blockid=\"rich-text-8ed29362\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"block-content text-block inner-wide align-center\" id=\"text-block-rich-text-8ed29362\">\n\t\t\t\t\t\t  \n\t\t\t\t\t\t      <div data-block-id=\"rich-text-8ed29362\" data-config=\"{&quot;blockName&quot;:&quot;richText&quot;,&quot;blockId&quot;:&quot;rich-text-8ed29362&quot;,&quot;blockType&quot;:&quot;rich-text&quot;,&quot;legacySpacingStyle&quot;:&quot;padding-top:0px; padding-bottom:10px; &quot;,&quot;content&quot;:&quot;&lt;p&gt;Every cut creates microscopic plastic fragments that break off into your food.&lt;/p&gt;&lt;p&gt;These microplastics can accumulate in the body and have been linked to &lt;strong&gt;inflammation, hormone disruption, and long-term health concerns.&lt;/strong&gt;&lt;/p&gt;&quot;,&quot;outerClassName&quot;:&quot;inner-wide align-center&quot;}\" data-hydration-root=\"true\"><div class=\"rich-text\" style=\"padding-top:0px;padding-bottom:10px\"><p>Every cut creates microscopic plastic fragments that break off into your food.</p><p>These microplastics can accumulate in the body and have been linked to <strong>inflammation, hormone disruption, and long-term health concerns.</strong></p></div></div>\n\t\t\t\t\t\t    \n\t\t\t\t\t\t</div></div>\t\t<div class=\"block  \" style=\" \" data-blocktype=\"html\" data-blockid=\"id-42660fef\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"block-content html-block\" id=\"html-block-block-id-42660fef\">\n\t\t\t\t\t\t  \n\t\t\t\t\t\t      <div data-block-id=\"id-42660fef\" data-config=\"{&quot;blockName&quot;:&quot;html&quot;,&quot;blockId&quot;:&quot;id-42660fef&quot;,&quot;blockType&quot;:&quot;html&quot;,&quot;content&quot;:&quot;&quot;}\" data-hydration-root=\"true\"><div><div class=\"product-intro\">\n\t\t\t\t\t\t  <div class=\"product-intro-left\">\n\t\t\t\t\t\t    <video autoplay=\"\" muted=\"\" playsinline=\"\" loop=\"\">\n\t\t\t\t\t\t      <source src=\"https://cdn.shopify.com/videos/c/o/v/9ca6fac0eb484eef86d3cb24110cd00d.mp4\" type=\"video/mp4\">\n\t\t\t\t\t\t    </video>\n\t\t\t\t\t\t  </div>\n\t\t\t\t\t\t</div></div></div>\n\t\t\t\t\t\t    \n\t\t\t\t\t\t</div></div>\t\t<div class=\"block  \" style=\" \" data-blocktype=\"generic-button\" data-blockid=\"id-0b8b8c93\">\n\t\t\t\t\t\t\n\t\t\t\t\t\t<div class=\"block-content generic-button-block inner-narrow\" id=\"generic-button-block-id-0b8b8c93\">\n